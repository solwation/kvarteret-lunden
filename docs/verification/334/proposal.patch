+const {chromium}=require('playwright'),fs=require('node:fs'),assert=require('node:assert/strict');
+(async()=>{const base=process.argv[2]||'http://127.0.0.1:8444',browser=await chromium.launch({executablePath:process.env.CHROME_PATH,args:['--no-sandbox','--use-angle=swiftshader','--enable-unsafe-swiftshader']});const errors=[],external=[];
+try{const ctx=await browser.newContext({viewport:{width:1000,height:700}});await ctx.route('**/*',r=>r.request().url().startsWith(base+'/')?r.continue():(external.push(r.request().url()),r.abort()));const page=await ctx.newPage();page.on('pageerror',e=>errors.push(e.message));await page.goto(base+'/?wind=0,0');await page.waitForFunction(()=>window.lundenViewer?.renderer.info.render.frame>0,null,{timeout:300000});await page.evaluate(()=>{const a=lundenViewer;a.navigation.teleport(1.35,0,6.35);a.camera.lookAt(.35,.9,5.7);});await page.waitForFunction(()=>lundenViewer.roomProbe.plan.current==='L:0:Badrum'&&lundenViewer.roomProbe.face<0,null,{timeout:180000,polling:500});
+const report=await page.evaluate(async()=>{const a=lundenViewer,{probeZone}=await import('/src/roomprobe.js');a.renderer.setAnimationLoop(null);const r=a.renderer,gl=r.getContext(),used=new Set(),restore=[];for(const name of ['drawElements','drawArrays','drawElementsInstanced','drawArraysInstanced']){const f=gl[name];if(!f)continue;gl[name]=function(...args){used.add(gl.getParameter(gl.CURRENT_PROGRAM));return f.apply(this,args);};restore.push(()=>gl[name]=f);}const ext=gl.getExtension('WEBGL_multi_draw');if(ext)for(const name of ['multiDrawElementsWEBGL','multiDrawArraysWEBGL','multiDrawElementsInstancedWEBGL','multiDrawArraysInstancedWEBGL']){const f=ext[name];if(!f)continue;ext[name]=function(...args){used.add(gl.getParameter(gl.CURRENT_PROGRAM));return f.apply(this,args);};restore.push(()=>ext[name]=f);}
+const draw=()=>{used.clear();r.info.reset();r.render(a.scene,a.camera);return{screenPrograms:used.size,calls:r.info.render.calls,triangles:r.info.render.triangles,cachedPrograms:r.info.programs.length};};const after=draw(),saved=[];for(const m of a.roomProbe.mats.keys()){saved.push([m,m.envMap,m.envMapIntensity]);m.envMap=null;}const baselineMaterials=draw();for(const[m,t,k]of saved){m.envMap=t;m.envMapIntensity=k;}const restored=draw();for(const f of restore)f();const tags=root=>{const set=new Set();root.traverse(o=>{for(const m of [].concat(o.material||[]))if(m.userData.roomProbe)set.add(m);});return [...set].map(m=>m.userData.roomProbe).sort();};const zones=a.world.units.map(u=>({id:u.id,tags:tags(u.object),zones:u.roomMaps.map((map,l)=>map.rooms.map(room=>{const zone=probeZone({x:room.x+u.ox,z:room.z+u.oz},l,null,u);return{name:room.name,zone,localRoom:zone?map.at(zone.x-u.ox,zone.z-u.oz):null,floor:u.levels[l].floor};}))}));return{after,baselineMaterials,restored,taggedMaterials:a.roomProbe.mats.size,cores:a.world.coreHouses.map(c=>({house:c.house,hasRoomMaps:!!c.roomMaps,tags:tags(c.object)})),units:zones};});report.errors=errors;report.external=external;fs.writeFileSync('docs/verification/334/screen.json',JSON.stringify(report,null,2));assert.equal(report.after.screenPrograms,report.baselineMaterials.screenPrograms,'ordinary screen program budget');assert.equal(report.after.calls,report.baselineMaterials.calls);assert.deepEqual(report.after,report.restored);for(const c of report.cores){assert.equal(c.hasRoomMaps,false);assert.deepEqual(c.tags,[]);}for(const u of report.units){assert(u.tags.includes('chrome'));assert(u.tags.includes('porcelain'));for(const level of u.zones)for(const z of level)if(z.zone){assert.equal(z.localRoom,z.name);assert.equal(z.zone.y,z.floor+1.3);assert(z.zone.key.startsWith(u.id+':'));}}assert.deepEqual(errors,[]);assert.deepEqual(external,[]);console.log(JSON.stringify(report,null,2));}finally{await browser.close();}})().catch(e=>{c